# All integrations are optional. The landing page runs without credentials.
# Use an actual HTTPS distribution release; do not point at a development bundle.
# Optional explicit override; otherwise discover the latest public release.
MACOS_DOWNLOAD_URL=
# Public owner/repo containing published installers; checked every five minutes.
RELEASES_REPOSITORY=
SITE_URL=
DEFAULT_LANGUAGE=en
# Add translated dictionaries before enabling secondary locales.
ADDITIONAL_LANGUAGES=
# Server-only Recursive Engine credentials. Never use NEXT_PUBLIC_ for these.
BRAIN_API_URL=
BRAIN_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Set only after the external TestFlight group and public link are approved and active.
TESTFLIGHT_PUBLIC_URL=
