    "main"
  ],
  "permissions": [
    "core:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "http://*" }, { "url": "https://*" }] },
    "dialog:allow-open",
    "core:window:allow-start-dragging"
  ]
}
