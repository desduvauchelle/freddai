{
  "identifier": "main",
  "description": "Local workspace UI and native file selection",
  "windows": [
    "main",
    "thread-*",
    "app-*",
    "bug-walk-pill"
  ],
  "permissions": [
    "core:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "http://*" }, { "url": "https://*" }] },
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$HOME/**" }, { "path": "/tmp/**" }, { "path": "/private/tmp/**" }, { "path": "/private/var/folders/**" }] },
    "dialog:allow-open",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "x-apple.systempreferences:*" }] }
  ]
}
