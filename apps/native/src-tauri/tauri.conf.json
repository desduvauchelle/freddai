{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freddai",
  "version": "1.0.0",
  "identifier": "com.freddai.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Freddai",
        "visible": false,
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 20, "y": 28 },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; frame-src data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/desduvauchelle/freddai/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4QjE3RDc3RUJFNDVCRTAKUldUZ1crVHJkMzJ4K0FSRDRiaHFFVEZlakpoUTJkWG1yNlpDV3F6VzBYUHB0UnJNWGVqNE9Od1cK"
    }
  }
}
